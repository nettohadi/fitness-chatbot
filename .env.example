# Database Configuration (Prisma)
# For local development:
DATABASE_URL=postgresql://your_user@localhost:5432/fitness_chatbot

# For Supabase (production):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Anthropic Claude API
ANTHROPIC_API_KEY=your_claude_api_key

# OpenRouter API (for LLM calls)
OPENROUTER_API_KEY=your_openrouter_api_key

# OpenAI API (for voice transcription via Whisper)
# Cost: ~$0.006/minute
OPENAI_API_KEY=your_openai_api_key

# LLM Model Configuration (via OpenRouter)
# Default: google/gemini-2.0-flash-001
# Alternatives: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, meta-llama/llama-3.1-8b-instruct
LLM_MODEL_ID=google/gemini-2.0-flash-001

# LLM Pricing per 1M tokens (for cost tracking)
# Gemini 2.0 Flash: 0.10 / 0.40
# GPT-4o mini: 0.15 / 0.60
# Claude 3.5 Haiku: 0.80 / 4.00
LLM_PRICING_INPUT=0.10
LLM_PRICING_OUTPUT=0.40

# Security (Optional)
TWILIO_WEBHOOK_SECRET=your_webhook_secret

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Debug API (for production debugging)
DEBUG_API_TOKEN=your_debug_api_token
VERCEL_DOMAIN=https://your-app.vercel.app
